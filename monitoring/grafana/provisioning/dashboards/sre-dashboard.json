{
  "id": null,
  "uid": "sre-capstone-main",
  "title": "SRE Capstone — E-Commerce Platform",
  "description": "Main SRE dashboard: SLIs, SLOs, request rates, latency, error budgets",
  "tags": ["sre", "ecommerce", "slo"],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(http_requests_total, job)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "label": "Service"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "🟢 Availability SLO (Target: 99.9%)",
      "type": "gauge",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 6 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0.99,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 0.999 },
              { "color": "green", "value": 0.9995 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "showThresholdLabels": true, "showThresholdMarkers": true },
      "targets": [{
        "expr": "1 - (sum(rate(http_requests_total{status_code=~\"5..\"}[5m])) / sum(rate(http_requests_total[5m])))",
        "legendFormat": "Availability"
      }]
    },
    {
      "id": 2,
      "title": "⚡ Latency SLO — p99 (Target: < 500ms)",
      "type": "gauge",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 6 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 0.3 },
              { "color": "red", "value": 0.5 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{
        "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
        "legendFormat": "p99 Latency"
      }]
    },
    {
      "id": 3,
      "title": "📊 Error Budget Remaining",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 6 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 0.25 },
              { "color": "green", "value": 0.5 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "colorMode": "background", "graphMode": "none", "justifyMode": "center" },
      "targets": [{
        "expr": "1 - (sum(rate(http_requests_total{status_code=~\"5..\"}[30d])) / sum(rate(http_requests_total[30d])) / 0.001)",
        "legendFormat": "Error Budget"
      }]
    },
    {
      "id": 4,
      "title": "📦 Orders Created / min",
      "type": "stat",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 6 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "color": { "mode": "palette-classic" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [{
        "expr": "rate(order_service_orders_created_total[5m]) * 60",
        "legendFormat": "Orders/min"
      }]
    },
    {
      "id": 5,
      "title": "📈 Request Rate by Service (req/s)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 10 } }
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        { "expr": "sum(rate(http_requests_total[2m])) by (job)", "legendFormat": "{{ job }}" }
      ]
    },
    {
      "id": 6,
      "title": "🔴 Error Rate by Service (%)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": { "lineWidth": 2, "fillOpacity": 20 },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "red", "value": 0.01 }] }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status_code=~\"5..\"}[2m])) by (job) / sum(rate(http_requests_total[2m])) by (job)",
          "legendFormat": "{{ job }} errors"
        }
      ]
    },
    {
      "id": 7,
      "title": "⏱ Request Latency Percentiles",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2 } }
      },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.90, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p90" },
        { "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 8,
      "title": "🗄 Database Query Duration (p95)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2 } }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(product_service_db_query_duration_seconds_bucket[5m])) by (le, operation))",
          "legendFormat": "product: {{ operation }}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(order_service_db_query_duration_seconds_bucket[5m])) by (le, operation))",
          "legendFormat": "order: {{ operation }}"
        }
      ]
    },
    {
      "id": 9,
      "title": "💾 Products In Stock",
      "type": "stat",
      "gridPos": { "x": 0, "y": 22, "w": 6, "h": 4 },
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [{ "expr": "product_service_products_in_stock_total", "legendFormat": "In Stock" }]
    },
    {
      "id": 10,
      "title": "📋 Pending Orders",
      "type": "stat",
      "gridPos": { "x": 6, "y": 22, "w": 6, "h": 4 },
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [{ "expr": "order_service_pending_orders", "legendFormat": "Pending" }]
    },
    {
      "id": 11,
      "title": "💰 Total Revenue",
      "type": "stat",
      "gridPos": { "x": 12, "y": 22, "w": 6, "h": 4 },
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } },
      "targets": [{ "expr": "order_service_revenue_total", "legendFormat": "Revenue" }]
    },
    {
      "id": 12,
      "title": "🖥 Node CPU Usage (%)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 26, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "lineWidth": 2, "fillOpacity": 15 } }
      },
      "targets": [
        {
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[2m])) * 100)",
          "legendFormat": "CPU {{ instance }}"
        }
      ]
    },
    {
      "id": 13,
      "title": "🧠 Node Memory Usage (%)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 26, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "lineWidth": 2, "fillOpacity": 15 } }
      },
      "targets": [
        {
          "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
          "legendFormat": "Memory {{ instance }}"
        }
      ]
    }
  ]
}
